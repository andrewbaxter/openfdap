{
  "$schema": "../source/generated/jsonschema/conformance.schema.json",
  "cases": [
    {
      "description": "A request without a token is rejected",
      "setup": {"tokens": ["root"]},
      "steps": [
        {"request": {"method": "GET", "path": []}, "expect": {"status": 401}},
        {"request": {"method": "POST", "path": ["a"], "body": 1}, "expect": {"status": 401, "db": null}}
      ]
    },
    {
      "description": "A request with an unknown token is rejected",
      "setup": {"tokens": ["root"], "db": {"a": 1}},
      "steps": [
        {"request": {"method": "GET", "path": [], "token": "unknown"}, "expect": {"status": 401}},
        {
          "request": {"method": "POST", "path": ["a"], "token": "unknown", "body": 1},
          "expect": {"status": 401, "db": {"a": 1}}
        },
        {
          "request": {"method": "DELETE", "path": [], "token": "unknown"},
          "expect": {"status": 401, "db": {"a": 1}}
        }
      ]
    },
    {
      "description": "A non-Bearer Authorization header is rejected",
      "setup": {"tokens": ["root"]},
      "steps": [
        {
          "request": {"method": "GET", "path": [], "headers": {"authorization": "Basic cm9vdDo="}},
          "expect": {"status": 401}
        }
      ]
    }
  ]
}
