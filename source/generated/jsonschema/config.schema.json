{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "bind_addr": {
      "description": "Address to serve on, like `0.0.0.0:64116`.",
      "type": "string"
    },
    "data_dir": {
      "description": "Directory in which to store database, will be created if it doesn't exist",
      "type": "string"
    },
    "max_write_bytes": {
      "description": "Maximum size in bytes of a `POST` request body. Defaults to 1 MiB.",
      "type": "integer",
      "format": "uint",
      "default": 1048576,
      "minimum": 0
    },
    "users": {
      "description": "Application tokens and their access - for setting up tokens for\napplications to access FDAP. This can also be done (identically) via the\n`fdap_user` root key in the FDAP tree.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/User"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "bind_addr",
    "data_dir",
    "users"
  ],
  "$defs": {
    "AccessAction": {
      "type": "object",
      "properties": {
        "read": {
          "type": "boolean"
        },
        "write": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "read",
        "write"
      ]
    },
    "AccessPair": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/AccessAction"
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccessPathSeg"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "action"
      ]
    },
    "AccessPathSeg": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "wildcard"
          ]
        },
        {
          "type": "object",
          "properties": {
            "string": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "string"
          ]
        }
      ]
    },
    "Token": {
      "description": "How an application token is stored in the config. Only hashes are accepted,\nso that the config file, the database and their backups never contain\nusable tokens.",
      "oneOf": [
        {
          "description": "Hex-encoded SHA-256 hash of the token. Generate with `openfdap hash-token`.",
          "type": "object",
          "properties": {
            "sha256": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "sha256"
          ]
        }
      ]
    },
    "User": {
      "type": "object",
      "properties": {
        "access": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccessPair"
          }
        },
        "token": {
          "$ref": "#/$defs/Token"
        }
      },
      "additionalProperties": false,
      "required": [
        "token",
        "access"
      ]
    }
  }
}